# Configuración del servidor para que lo pele
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# CORS - Orígenes permitidos (separados por comas)
CORS_ORIGINS_DEV=http://localhost:4200,http://localhost:3000,https://hoppscotch.io,https://app.hoppscotch.io,http://localhost:3333
CORS_ORIGINS_PROD=https://yourdomain.com

# Base de datos (configuración local)
# DATABASE_URL se construye automáticamente a partir de estas variables
DB_HOST=localhost
DB_PORT=3306
DBNAMES=infraestructura
DB_USER=root
DB_PASSWORD=root

#Prefijo para rutas servidor
#HOST=/app/infraestructura/

#Prefijo para rutas local
HOST=/

#DATABASE_URL=mysql://root:root@localhost:3306/infraestructura

DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DBNAMES}

# JWT
JWT_SECRET=HHH_CP2025
JWT_EXPIRES_IN=15m

#algo
# Bcrypt
BCRYPT_ROUNDS=12

# Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENTS=pdf,doc,docx

# Correos (para desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Tu Ecommerce

# Pagos (para desarrollo)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
WEBHOOK_SECRET=dev_webhook_secret

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Monitoreo del pool en desarrollo
ENABLE_POOL_MONITORING=true
POOL_MONITORING_INTERVAL=60000
JWT_REFRESH_EXPIRES_IN=7d
